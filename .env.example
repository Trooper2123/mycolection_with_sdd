# MyCollection - Variáveis de Ambiente

# ===== BACKEND =====
# Porta do backend
BACKEND_PORT=8080
# Perfil do Spring (dev, test, production)
SPRING_PROFILES_ACTIVE=dev

# ===== BFF =====
# Porta do BFF
BFF_PORT=8081
# URL base do Core API (backend)
CORE_API_BASE_URL=http://localhost:8080

# ===== FRONTEND =====
# URL da API (BFF)
API_URL=http://localhost:8081
# Ambiente (development, production)
NODE_ENV=development

# ===== DATABASE (Production) =====
# Se usar PostgreSQL em produção
DB_URL=jdbc:postgresql://localhost:5432/mycolection
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver

# ===== LOGGING =====
LOG_LEVEL=INFO
SPRING_JPA_SHOW_SQL=false

# ===== CORS (Production Vercel) =====
# URLs permitidas para CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://seu-app.vercel.app

